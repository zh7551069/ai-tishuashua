DATABASE_URL=postgres://tishuashua:tishuashua@127.0.0.1:5432/tishuashua

OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
