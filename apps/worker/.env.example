# 复制为 apps/worker/.env。未提供时回落到仓库根目录 .env。
# quiz.generate 会连接 PostgreSQL，并按 LLM_MOCK 或 LLM_API_KEY 出题。

WORKER_PORT=3001
REDIS_URL=redis://127.0.0.1:6379

DATABASE_URL=postgres://tishuashua:tishuashua@127.0.0.1:5432/tishuashua

OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
# 与 API 使用同一个开关。true 或 1 才 mock，默认关闭。
LLM_MOCK=false
