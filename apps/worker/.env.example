# 复制为 apps/worker/.env。未提供时回落到仓库根目录 .env。
# quiz.generate 与 courseware.extract 都会连接 PostgreSQL。
# 对象存储要和 API 使用同一套 OSS_* / OSS_LOCAL_DIR，否则 Worker 读不到课件。

WORKER_PORT=3001
REDIS_URL=redis://127.0.0.1:6379

DATABASE_URL=postgres://tishuashua:tishuashua@127.0.0.1:5432/tishuashua

OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=us-east-1
OSS_FORCE_PATH_STYLE=true
OSS_LOCAL_DIR=

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
# 与 API 使用同一个开关。true 或 1 才 mock 出题和提炼，默认关闭。
LLM_MOCK=false
