{
  "name": "@tishuashua/mini",
  "version": "0.0.0",
  "private": true,
  "description": "题刷刷微信小程序（Taro + React）。不是微信云开发。",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "None",
    "framework": "React"
  },
  "scripts": {
    "dev": "taro build --type weapp --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "build": "taro build --type weapp",
    "build:weapp": "taro build --type weapp",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --import tsx --test src/services/exhausted-sheet.test.ts src/services/membership-pay.test.ts"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.4",
    "@tarojs/components": "4.3.1",
    "@tarojs/helper": "4.3.1",
    "@tarojs/plugin-framework-react": "4.3.1",
    "@tarojs/plugin-platform-weapp": "4.3.1",
    "@tarojs/react": "4.3.1",
    "@tarojs/runtime": "4.3.1",
    "@tarojs/shared": "4.3.1",
    "@tarojs/taro": "4.3.1",
    "@tishuashua/shared": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.4",
    "@babel/plugin-transform-class-properties": "7.25.9",
    "@babel/preset-react": "^7.24.1",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.5",
    "@tarojs/cli": "4.3.1",
    "@tarojs/plugin-generator": "4.3.1",
    "@tarojs/taro-loader": "4.3.1",
    "@tarojs/webpack5-runner": "4.3.1",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.18",
    "@types/webpack-env": "^1.13.6",
    "babel-preset-taro": "4.3.1",
    "postcss": "^8.5.6",
    "react-refresh": "^0.14.0",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "webpack": "5.91.0"
  }
}
