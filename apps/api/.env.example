# 复制为 apps/api/.env。未提供时会回落到仓库根目录 .env。
# 不要提交真实密钥。微信 AppSecret 只放在这里，不要放进小程序。

PORT=3000
DATABASE_URL=postgres://tishuashua:tishuashua@127.0.0.1:5432/tishuashua
REDIS_URL=redis://127.0.0.1:6379

# 限流。false 或 0 关闭。没有 Redis 时不拦截。阈值说明见 docs/rate-limit.md。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WECHAT_LOGIN_MAX=60
RATE_LIMIT_ADMIN_LOGIN_MAX=30
RATE_LIMIT_WECHAT_API_MAX=300
RATE_LIMIT_WECHAT_IP_MAX=600
RATE_LIMIT_ADMIN_API_MAX=120
RATE_LIMIT_ADMIN_IP_MAX=240
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_QUIZ_CREATE_MAX=60
RATE_LIMIT_COURSEWARE_UPLOAD_MAX=40
# true 或 1 才信任 X-Forwarded-For。本机直连保持 false。
TRUST_PROXY=false
ADMIN_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# 后管帐密。示例只给本机，生产换成强口令。不要放进 apps/admin 或小程序。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tishuashua-admin

WECHAT_APP_ID=wx4a05165349e0e67c
WECHAT_APP_SECRET=
# true 或 1 才启用。不请求微信。登录用 code 映射 openId；设置页手机号授权也走这份 mock。生产不要打开。
WECHAT_LOGIN_MOCK=false

# 四项都填才走 S3。否则课件写到 OSS_LOCAL_DIR，缺省是仓库 data/courseware。
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=us-east-1
OSS_FORCE_PATH_STYLE=true
OSS_LOCAL_DIR=

LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
# true 或 1 才启用。不请求 DeepSeek / 通义。出题和课件提炼共用。生产不要打开。
LLM_MOCK=false

# 微信支付。只写变量名。私钥和 APIv3 密钥不要写进仓库。生产不要打开 mock。
# 未配齐且 WECHAT_PAY_MOCK 不是 true 或 1 时，下单返回 PAY_NOT_CONFIGURED。
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_PLATFORM_CERT_PATH=
WECHAT_PAY_MOCK=false
WECHAT_PAY_ENABLED=
