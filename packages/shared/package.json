{
  "name": "@tishuashua/shared",
  "version": "0.0.0",
  "private": true,
  "description": "题刷刷共享类型、常量与队列契约",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generation": {
      "types": "./dist/generation.d.ts",
      "default": "./dist/generation.js"
    }
  },
  "typesVersions": {
    "*": {
      "generation": ["dist/generation.d.ts"]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  }
}
