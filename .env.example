# 复制为仓库根目录 .env 后再填本地值。不要提交 .env，不要写入真实密钥。
# 下列口令与 docker-compose.yml 的本地开发默认值一致，只用于本机。

# --- PostgreSQL / Redis ---
DATABASE_URL=postgres://tishuashua:tishuashua@127.0.0.1:5432/tishuashua
REDIS_URL=redis://127.0.0.1:6379

# --- API / Worker 端口 ---
PORT=3000
WORKER_PORT=3001

# 管理后台开发源，逗号分隔。供 API CORS 使用。
ADMIN_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# --- 微信小程序（AppSecret 只放在服务端） ---
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 本地没有真实小程序密钥时，显式设为 true 才启用登录 mock。默认关闭，生产不要打开。
WECHAT_LOGIN_MOCK=false

# --- 对象存储（COS/OSS）。课件上限 50MB，见 packages/shared ---
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# --- 国内 LLM：deepseek 或 tongyi。没有 Key 时不要假装可出题 ---
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
# 只有 true 或 1 才用内置 mock 出题，不请求模型。默认关闭，生产不要打开。
LLM_MOCK=false

# --- 管理后台（Vite 只暴露 VITE_ 前缀） ---
VITE_API_BASE=http://127.0.0.1:3000/api

# --- 小程序可公开配置。不要把 WECHAT_APP_SECRET 写进小程序环境 ---
TARO_APP_API_BASE=http://127.0.0.1:3000/api
