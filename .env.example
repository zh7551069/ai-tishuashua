# 复制为仓库根目录 .env 后再填本地值。不要提交 .env，不要写入真实密钥。
# 下列口令与 docker-compose.yml 的本地开发默认值一致，只用于本机。

# --- PostgreSQL / Redis ---
DATABASE_URL=postgres://tishuashua:tishuashua@127.0.0.1:5432/tishuashua
REDIS_URL=redis://127.0.0.1:6379

# --- API / Worker 端口 ---
PORT=3000
WORKER_PORT=3001

# --- API 限流。计数在 Redis。只有 false 或 0 关闭；不填也是开启。本机可改成 false，或把阈值调大。
# 窗口单位是秒。微信登录按 IP；后管登录按 IP 和帐号各计一份。已登录接口另按身份计数。
# 健康检查和 OpenAPI 不计。没有 Redis 时限流不拦截，会话和入队仍返回 REDIS_UNAVAILABLE。见 docs/rate-limit.md。
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_WECHAT_LOGIN_MAX=60
RATE_LIMIT_ADMIN_LOGIN_MAX=30
RATE_LIMIT_WECHAT_API_MAX=300
RATE_LIMIT_WECHAT_IP_MAX=600
RATE_LIMIT_ADMIN_API_MAX=120
RATE_LIMIT_ADMIN_IP_MAX=240
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_QUIZ_CREATE_MAX=60
RATE_LIMIT_COURSEWARE_UPLOAD_MAX=40
# 只有 true 或 1 才信任反向代理的 X-Forwarded-For。默认关闭，避免伪造来源 IP。
TRUST_PROXY=false

# 管理后台开发源，逗号分隔。供 API CORS 使用。
ADMIN_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# 后管帐密只放在 API。下面是本机示例，生产必须换成强口令，不要提交真实口令。
# 两项都留空时登录返回 ADMIN_NOT_CONFIGURED，代码里没有默认帐号。
# 不要写成 VITE_ 变量，也不要放进小程序环境。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=tishuashua-admin

# --- 微信小程序（AppSecret 只放在服务端） ---
WECHAT_APP_ID=wx2c745e1d25e57175
WECHAT_APP_SECRET=
# 本地没有真实小程序密钥时，显式设为 true 才启用。登录和设置页手机号授权都走 mock，不请求微信。默认关闭，生产不要打开。
WECHAT_LOGIN_MOCK=false

# --- 对象存储。四项都填才走 S3 兼容接口（MinIO / COS / OSS）。缺任一项则写本地目录，不访问云。
# 不要把真实密钥提交进仓库。课件上限 50MB，见 packages/shared。
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# MinIO 本地常用 us-east-1，并保持 path-style。
OSS_REGION=us-east-1
OSS_FORCE_PATH_STYLE=true
# 可选。不填时课件落在仓库 data/courseware。API 和 Worker 必须看到同一个目录。
OSS_LOCAL_DIR=

# --- 国内 LLM：deepseek 或 tongyi。没有 Key 时不要假装可出题或提炼 ---
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_BASE_URL=
# 只有 true 或 1 才用内置 mock，不请求模型。默认关闭，生产不要打开。
LLM_MOCK=false

# --- 管理后台（Vite 只暴露 VITE_ 前缀） ---
# Vite 不读仓库根目录的 .env。本地开发把这一行复制到 apps/admin/.env。
# 生产构建必须是 /api，见 apps/admin/.env.production.example 和 docs/deploy.md。
VITE_API_BASE=http://47.95.33.119/api

# --- 小程序可公开配置。不要把 WECHAT_APP_SECRET 写进小程序环境 ---
TARO_APP_API_BASE=http://47.95.33.119/api
